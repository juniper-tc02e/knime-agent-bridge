{
  "name": "knime-agent-bridge",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local live KNIME agent bridge: shared IPC client, CLI and MCP server",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "knime-agent": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:adapter": "node --test tests/client.test.mjs tests/mcp.test.mjs tests/launcher.test.mjs tests/launcher-modern.test.mjs",
    "test:beta": "node scripts/verify-beta.mjs",
    "mcp": "node src/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "playwright-core": "1.63.0",
    "zod": "3.25.76"
  }
}
